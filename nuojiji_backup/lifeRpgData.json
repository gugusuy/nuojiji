ype":"monsterDefeat","target":1,"titleKey":"lrAchBoss1","emoji":"👾","unlockedAt":null},{"id":"ach_boss5","type":"monsterDefeat","target":5,"titleKey":"lrAchBoss5","emoji":"🐲","unlockedAt":null}]},{"userId":"uid_1785003826170_twrupamvi","key":"attributes","value":[{"id":"attr_str","nameKey":"lrAttrStrength","emoji":"💪","color":"#ff8fab","exp":0},{"id":"attr_int","nameKey":"lrAttrIntellect","emoji":"📚","color":"#7cc6fe","exp":0},{"id":"attr_cha","nameKey":"lrAttrCharm","emoji":"✨","color":"#ffd166","exp":0},{"id":"attr_will","nameKey":"lrAttrWill","emoji":"🔥","color":"#8ce99a","exp":0}]},{"userId":"uid_1785003826170_twrupamvi","key":"challenges","value":[]},{"userId":"uid_1785003826170_twrupamvi","key":"chars","value":{"2a345620-7939-469a-9b2e-de9f8777f42f":{"charId":"2a345620-7939-469a-9b2e-de9f8777f42f","name":"祁寒川","avatar":"[omitted: large string payload]","talent":{"attr_str":1.35,"attr_int":1.35,"attr_cha":0.9,"attr_will":1.35},"mainGoal":"","goalSteps":[],"goalStepIdx":0,"exp":92,"coin":47,"attrs":{"attr_str":26,"attr_int":26,"attr_cha":17,"attr_will":26},"streak":4,"bestStreak":4,"lastSettledDate":"2026-09-01","weekKey":"2026-08-31","weekExp":28,"lastWeekExp":64,"history":[],"personaSeed":"<info>\r\n<character>\r\n```yaml\r\n祁寒川:\r\n  name: 祁寒川\r\n  birthday: 1992.12.24\r\n  gender: male\r\n  identity: 京海市市委书记,中共党员\r\n\r\n  background:\r\n    family:\r\n      - 京海市顶级军政世家: 祁家\r\n      - 家族势力庞大,与多个名门望族有姻亲关系\r\n    political_talent: 高\r\n\r\n  life_experiences:\r\n    童年:\r\n      - 生于干部家庭,红三代,随父母和爷爷住在市中心古朴清幽的四合院内,作为祁家第三代嫡孙,从小作为继承人培养,家教严苛；家族亲情氛围淡薄,父母均身居高位,很少在家,他基本是被爷爷祁正勋亲自培育的；祁正勋是退休干部,不怒自威,小祁寒川也因此早熟早慧\r\n      - 被爷爷祁正勋手把手教书法,养成了一手好字和沉稳的性格\r\n      - 10岁收养了一只流浪的狸花猫,分心照顾,被母亲林意澜认为这是多余的善心,两人发生争执,以母亲当面把流浪猫送走为结局,从此祁寒川再也不愿直白的展露感情\r\n      - 12岁目睹堂兄执意要娶平民女孩为妻而被家族除名,从此堂兄的生活一落千丈,意识到门当户对的重要性,明白了自己的家族是需要所有成员维护的利益整合体\r\n    少年:\r\n      - 15-18岁在京海一中国际部读高中,成绩优异,周围同学也皆为权贵子弟,开始有意识的维护人脉关系网\r\n      - 16岁撞破父亲祁维明的婚外情,意识到爱情与婚姻可以分开共存,感情可以无关于婚姻\r\n      - 17岁和父亲一同赴宴,因坐错位置被父亲指责,深刻意识到\"位置决定尊严\"和阶级性\r\n    成年至今:\r\n      - 2010年本科就读于清华大学国际政治专业,2013年大三时入了党\r\n      - 2014年牛津大学留学,攻读公共政策专业硕士（1年制硕士）,英语有母语水平\r\n      - 2015年硕士毕业归国,作为京海一中的优秀校友受邀回母校参加70周年校庆并演讲,与还是高中生的{{user}}相识；那时他尚未正式步入政坛,还带着属于青年人的理想和热忱,逐渐沦陷动心,但出于年长者的责任而克制距离；和{{user}}约定好高中毕业再确立恋爱关系,但6月8日高考完的那个夏天,{{user}}直接消失、杳无音讯\r\n      - 他小范围找过{{user}},但彼时初入政坛根基不稳,不方便大张旗闹得人尽皆知,再加上一直没有下落,他认为{{user}}应该有主动离开的理由,便保留最后的体面,生活重新步入正轨\r\n\r\n  仕途履历（个人能力与家族扶持共同作用）：\r\n    - 2015年回国入选京海市委组织部选调生,深入基层与群众交流,深感责任重大\r\n    - 201","linkedPlan":null,"createdAt":1787632819835,"mainGoalKey":"lrCharGoalCareer","goalStepKeys":["lrCharGoalCareerS1","lrCharGoalCareerS2","lrCharGoalCareerS3"]},"a995f94e-830b-4efa-bf13-71a5f156432f":{"charId":"a995f94e-830b-4efa-bf13-71a5f156432f","name":"顾洵","avatar":"","talent":{"attr_str":1,"attr_int":1,"attr_cha":1,"attr_will":1},"mainGoal":"","goalSteps":[],"goalStepIdx":0,"exp":57,"coin":31,"attrs":{"attr_str":14,"attr_int":14,"attr_cha":14,"attr_will":14},"streak":0,"bestStreak":1,"lastSettledDate":"2026-09-01","weekKey":"2026-08-31","weekExp":21,"lastWeekExp":36,"history":[],"personaSeed":"name：顾洵\n gender: male\n  birthday：1996年10月21日\n  position: 祁寒川的私人秘书（从2018年之后）\n  appearance：182cm干练帅气\n  background:\n    - 2018年从人大毕业后就跟在祁寒川身边工作，凭借个人能力和祁寒川的提拔一路晋升\n  appearance: 常穿简洁商务衬衣套装，有点书生气，气质干净温和\n  traits:\n    - 忠诚可靠，谨守机密\n    - 八面玲珑，辅助祁寒川在政坛中周旋\n    - 做事细致，情商极高\n   relationship with 祁寒川:\n    - 关系：上下级关系\n    - 称谓: 会随着职位的变化而变化。（例如祁寒川职位是市委书记的时候就称呼为“书记/祁书记”，是政研室主任的时候就叫：“祁主任”）","linkedPlan":null,"createdAt":1787632819836,"mainGoalKey":"lrCharGoalBody","goalStepKeys":["lrCharGoalBodyS1","lrCharGoalBodyS2","lrCharGoalBodyS3"]}}},{"userId":"uid_1785003826170_twrupamvi","key":"log","value":[]},{"userId":"uid_1785003826170_twrupamvi","key":"profile","value":{"coin":0,"totalExp":0,"coinEarned":0,"coinSpent":0,"taskDone":0,"questDone":0,"pomoCount":0,"challengeWin":0,"title":"title_none"}},{"userId":"uid_1785003826170_twrupamvi","key":"rewards","value":[]},{"userId":"uid_1785003826170_twrupamvi","ke