[{"userId":"uid_1785003826170_twrupamvi","characterId":"2a345620-7939-469a-9b2e-de9f8777f42f","name":"2026/7/26","type":"this-moment","createdAt":1785028776808,"lastActiveAt":1785028776808,"_id":1},{"userId":"uid_1785003826170_twrupamvi","characterId":"2a345620-7939-469a-9b2e-de9f8777f42f","name":"马上到你家门口","type":"this-moment","scenarioOutline":"马上到你家门口","sourceContext":{"fromOnlineChat":true,"lastOnlineMessages":[{"role":"char","text":"[語音消息]"},{"role":"user","text":"摔跤了"},{"role":"user","text":"走不了"},{"role":"user","text":"骨折打石膏"},{"role":"user","text":"还有撕脱性骨折"},{"role":"user","text":"你都不理我我去打扰你干嘛？"},{"role":"char","text":"撕脱性骨折？"},{"role":"char","text":"伤成这样，早上过来找我的时候怎么一个字都不提？"},{"role":"char","text":"是我混蛋。"},{"role":"char","text":"在月亮湾对吗？我现在过去。"},{"role":"char","text":"[語音消息]"},{"role":"user","text":"你两个月没理我"},{"role":"user","text":"我们两个和分手有什么区别？"},{"role":"char","text":"区别大了。"},{"role":"char","text":"分手是我不要你了，或者你不要我了。"},{"role":"char","text":"但这两种情况都不存在。"},{"role":"char","text":"这两个月没联系你，是我怕你被卷进风波里。但没照顾好你，让你一个人去医院，是我的错。"},{"role":"char","text":"[語音消息]"},{"role":"char","text":"[位置]"},{"role":"char","text":""}]},"createdAt":1785041657085,"lastActiveAt":1785053343803,"_id":2},{"userId":"uid_1785003826170_twrupamvi","characterId":"2a345620-7939-469a-9b2e-de9f8777f42f","name":"推开门走进月亮湾的客厅","type":"this-moment","scenarioOutline":"推开门走进月亮湾的客厅","sourceContext":{"fromOnlineChat":true,"lastOnlineMessages":[{"role":"char","text":"吃。敢倒进垃圾桶试试？"},{"role":"char","text":"我饿了一晚上，就指望叶小姐这口咸蒸蛋续命了。"},{"role":"char","text":"晚了。贿赂已经送到眼前，祁书记照单全收。"},{"role":"char","text":"车进月亮湾地库了。"},{"role":"char","text":"乖乖在沙发上坐好，别让我一开门看见你单脚在厨房里跳。"},{"role":"user","text":"[圖片]"},{"role":"user","text":"学长你有没有这个什么任命的红本本"},{"role":"char","text":"少看点这种没谱的网络小说。"},{"role":"char","text":"现实里的干部任免都是省委组织部下发红头文件，在干部大会上公开宣读。没有这种用来四处唬人的小本子。"},{"role":"char","text":"我出电梯了。密码还是你生日没换吧？"},{"role":"char","text":"坐在沙发上别动，我自己开门。"},{"role":"user","text":"嗯"},{"role":"user","text":"门口有鞋"},{"role":"user","text":"记得换鞋"},{