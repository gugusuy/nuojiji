[{"tbl":"memory","rowKey":"uid_1785003826170_twrupamvi|2a345620-7939-469a-9b2e-de9f8777f42f","field":"stanceHistory","userId":"uid_1785003826170_twrupamvi","itemId":"1qvo8cnonf8","data":{"text":"看着她应酬完乖乖回到我身边，又窝在被子里好奇我的工作，忍不住想纵容她的一切小探究，更盼着能将她牢牢带在身边。","version":193,"updatedAt":"2026-09-26T06:46:43.826Z","basedOnEventId":1790405203424,"basedOnSummaryCount":303},"updatedAt":1790581602291},{"tbl":"memory","rowKey":"uid_1785003826170_twrupamvi|2a345620-7939-469a-9b2e-de9f8777f42f","field":"stanceHistory","userId":"uid_1785003826170_twrupamvi","itemId":"1w1rasn8m3u","data":{"text":"听见她说好像没那么想我，嘴上虽然笑话她翅膀硬了，心里却容不得她单方面抽离，只盼着赶快忙完回家，看她当面还怎么嘴硬。","version":194,"updatedAt":"2026-09-28T07:46:42.214Z","basedOnEventId":1790581601568,"basedOnSummaryCount":305},"updatedAt":1790583143952},{"tbl":"memory","rowKey":"uid_1785003826170_twrupamvi|2a345620-7939-469a-9b2e-de9f8777f42f","field":"stanceHistory","userId":"uid_1785003826170_twrupamvi","itemId":"lj1dkynkor","data":{"text":"看着她为应酬疲惫又乖顺依赖我，只想快点带她回北京定下名分，替她挡掉所有试探与风雨。","version":192,"updatedAt":"2026-09-25T11:08:22.290Z","basedOnEventId":1790334502004,"basedOnSummaryCount":303},"updatedAt":1790405203860}]