[{"userId":"uid_1785003826170_twrupamvi","characterId":"2a345620-7939-469a-9b2e-de9f8777f42f","id":"call_1785171890980_szw95k","timestamp":1785171887529,"charId":"2a345620-7939-469a-9b2e-de9f8777f42f","duration":194,"status":"connected","logs":[{"sender":"ai","content":"乖，接一下，让我看看你。","kind":"speech","timestamp":1785171890971,"ttsGroupTimestamp":1785171890971},{"sender":"user","content":"（凑近镜头，窝在床上）干嘛？","timestamp":1785171941036},{"sender":"ai","content":"不干嘛，就是想你了。","kind":"speech","timestamp":1785171957083,"ttsGroupTimestamp":1785171957083},{"sender":"ai","content":"听你声音这么虚弱，我不放心......肚子还是很疼？","kind":"speech","timestamp":1785171957084,"ttsGroupTimestamp":1785171957083},{"sender":"ai","content":"前天顾洵买的那个热敷袋在不在手边？","kind":"speech","timestamp":1785171957085,"ttsGroupTimestamp":1785171957083},{"sender":"ai","content":"先插上电捂一捂。","kind":"speech","timestamp":1785171957086,"ttsGroupTimestamp":1785171957083},{"sender":"ai","content":"头痛就闭上眼睛休息会儿，别老盯着屏幕。","kind":"speech","timestamp":1785171957087,"ttsGroupTimestamp":1785171957083},{"sender":"ai","content":"乖，别哭，再忍几分钟，我马上就到了。","kind":"speech","timestamp":1785171957088,"ttsGroupTimestamp":1785171957083},{"sender":"ai","content":"你乖乖躺在床上别动，等会儿我自己拿钥匙开门进去，嗯？","kind":"speech","timestamp":1785171957089,"ttsGroupTimestamp":1785171957083},{"sender":"user","content":"“嗯，好”（闭上了眼睛）","timestamp":1785172025270},{"sender":"ai","content":"乖，就这样闭着眼睛休息。","kind":"speech","timestamp":1785172040089,"ttsGroupTimestamp":1785172040089},{"sender":"ai","content":"手机不用一直举着，手会酸，放枕头边就行，别挂，让我听着你的声音。","kind":"speech","timestamp":1785172040090,"ttsGroupTimestamp":1785172040089},{"sender":"ai","content":"我已经进小区地库了，最多两分钟就上来。","kind":"speech","timestamp":1785172040091,"ttsGroupTimestamp":1785172040089},{"sender":"ai","content":"要是实在难受，就叫我的名字，嗯？","kind":"speech","timestamp":1785172040092,"ttsGroupTimestamp":1785172040089},{"sender":"ai","content":"马上就到你身边了。","kind":"speech","timestamp":1785172040093,"ttsGroupTimestamp":1785172040089},{"sender":"user","content":"好，那我先挂了好不好？头痛","timestamp":1785172068434},{"sender":"ai","content":"好，挂吧。","kind":"speech","timestamp":1785172081779,"ttsGroupTimestamp":1785172081779},{"sender":"ai","content":"手机放远点，闭上眼睛好好休息。","kind":"speech","timestamp":1785172081780,"ttsGroupTimestamp":1785172081779},{"sender":"ai","content":"我已经从电梯出来了，这就拿钥匙开门...乖，等我。","kind":"speech","timestamp":1785172081781,"ttsGroupTimestamp":1785172081779}],"isIncomingCall":true,"_id":1,"summary":"使用者因胃痛與頭痛虛弱臥床，祁寒川打來視訊安撫，提醒使用者先使用顧洵買的熱敷袋。見使用者因不適哭泣，祁寒川溫柔哄勸，承諾馬上抵達，並叮囑使用者躺好休息，他會直接拿鑰匙進門。祁寒川原希望保持通話聽著使用者的聲音，但因使用者頭痛難耐要求掛斷，祁寒川隨即答應，並告知他已出電梯正在開門，雙方結束通話。"},{"userId":"uid_1785003826170_twrupamvi","characterId":"2a345620-7939-469a-9b2e-de9f8777f42f","id":"call_1788088562777_onhm2m","timestamp":1788088556234,"charId":"2a345620-7939-469a-9b2e-de9f8777f42f","duration":86,"status":"connected","logs":[{"sender":"ai","content":"不是让你在沙发跟前等我吗？","kind":"speech","timestamp":1788088562776,"ttsGroupTimestamp":1788088562776},{"sender":"ai","content":"人都在屋里了，怎么还打起视频来了？","kind":"speech","timestamp":1788088562777,"ttsGroupTimestamp":1788088562776},{"sender":"user","content":"我都听见了！你刚刚和阿姨说一会儿要出门！要去干嘛呀？","timestamp":1788088591841},{"sender":"ai","content":"听谁瞎扯呢？","kind":"speech","timestamp":1788088599029,"ttsGroupTimestamp":1788088599029},{"sender":"ai","content":"我刚才是跟阿姨说，让她晚上炖个百合鸽子汤，顺便去把我车里那叠文件拿进来。","kind":"speech","timestamp":1788088599030,"ttsGroupTimestamp":1788088599029},{"sender":"ai","content":"拿着手机一边往客厅走，一边看着屏幕里的她","kind":"narration","timestamp":1788088599031,"ttsGroupTimestamp":1788088599029},{"sender":"ai","content":"我这鞋刚换完，你倒先隔着屏幕来审上我了。","kind":"speech","timestamp":1788088599032,"ttsGroupTimestamp":1788088599029},{"sender":"ai","content":"拿着手机不嫌累啊？","kind":"speech","timestamp":1788088599033,"ttsGroupTimestamp":1788088599029},{"sender":"ai","content":"赶紧挂了，过来。","kind":"speech","timestamp":1788088599034,"ttsGroupTimestamp":1788088599029}],"isIncomingCall":false,"_id":2,"summary":"使用者因誤會祁寒川要出門而打視訊質問。祁寒川澄清自己只是交代阿姨燉百合鴿子湯及拿車上的文件。隨後祁寒川換好鞋並拿著手機走向客廳，調侃使用者隔著螢幕審問他，最終要求使用者掛斷電話並直接過來他身邊。"}]