[{"userId":"uid_1785003826170_twrupamvi","characterId":"2a345620-7939-469a-9b2e-de9f8777f42f","id":"call_1785171890980_szw95k","timestamp":1785171887529,"charId":"2a345620-7939-469a-9b2e-de9f8777f42f","duration":194,"status":"connected","logs":[{"sender":"ai","content":"乖，接一下，让我看看你。","kind":"speech","timestamp":1785171890971,"ttsGroupTimestamp":1785171890971},{"sender":"user","content":"（凑近镜头，窝在床上）干嘛？","timestamp":1785171941036},{"sender":"ai","content":"不干嘛，就是想你了。","kind":"speech","timestamp":1785171957083,"ttsGroupTimestamp":1785171957083},{"sender":"ai","content":"听你声音这么虚弱，我不放心......肚子还是很疼？","kind":"speech","timestamp":1785171957084,"ttsGroupTimestamp":1785171957083},{"sender":"ai","content":"前天顾洵买的那个热敷袋在不在手边？","kind":"speech","timestamp":1785171957085,"ttsGroupTimestamp":1785171957083},{"sender":"ai","content":"先插上电捂一捂。","kind":"speech","timestamp":1785171957086,"ttsGroupTimestamp":1785171957083},{"sender":"ai","content":"头痛就闭上眼睛休息会儿，别老盯着屏幕。","kind":"speech","timestamp":1785171957087,"ttsGroupTimestamp":1785171957083},{"sender":"ai","content":"乖，别哭，再忍几分钟，我马上就到了。","kind":"speech","timestamp":1785171957088,"ttsGroupTimestamp":1785171957083},{"sender":"ai","content":"你乖乖躺在床上别动，等会儿我自己拿钥匙开门进去，嗯？","kind":"speech","timestamp":1785171957089,"ttsGroupTimestamp":1785171957083},{"sender":"user","content":"“嗯，好”（闭上了眼睛）","timestamp":1785172025270},{"sender":"ai","content":"乖，就这样闭着眼睛休息。","kind":"speech","timestamp":1785172040089,"ttsGroupTimestamp":1785172040089},{"sender":"ai","content":"手机不用一直举着，手会酸，放枕头边就行，别挂，让我听着你的声音。","kind":"speech","timestamp":1785172040090,"ttsGroupTimestamp":1785172040089},{"sender":"ai","content":"我已经进小区地库了，最多两分钟就上来。","kind":"speech","timestamp":1785172040091,"ttsGroupTimestamp":1785172040089},{"sender":"ai","content":"要是实在难受，就叫我的名字，嗯？","kind":"speech","timestamp":1785172040092,"ttsGroupTimestamp":1785172040089},{"sender":"ai","content":"马上就到你身边了。","kind":"speech","timestamp":1785172040093,"ttsGroupTimestamp":1785172040089},{"sender":"user","content":"好，那我先挂了好不好？头痛","timestamp":1785172068434},{"sender":"ai","content":"好，挂吧。","kind":"speech","timestamp":1785172081779,"ttsGroupTimestamp":1785172081779},{"sender":"ai","content":"手机放远点，闭上眼睛好好休息。","kind":"speech","timestamp":1785172081780,"ttsGroupTimestamp":1785172081779},{"sender":"ai","content":"我已经从电梯出来了，这就拿钥匙开门...乖，等我。","kind":"speech","timestamp":1785172081781,"ttsGroupTimestamp":1785172081779}],"isIncomingCall":true,"_id":1,"summary":"使用者因胃痛與頭痛虛弱臥床，祁寒川打來視訊安撫，提醒使用者先使用顧洵買的熱敷袋。見使用者因不適哭泣，祁寒川溫柔哄勸，承諾馬上抵達，並叮囑使用者躺好休息，他會直接拿鑰匙進門。祁寒川原希望保持通話聽著使用者的聲音，但因使用者頭痛難耐要求掛斷，祁寒川隨即答應，並告知他已出電梯正在開門，雙方結束通話。"},{"userId":"uid_1785003826170_twrupamvi","characterId":"2a345620-7939-469a-9b2e-de9f8777f42f","id":"call_1788938096580_89ky8j","timestamp":1788938090365,"charId":"2a345620-7939-469a-9b2e-de9f8777f42f","duration":69,"status":"interrupted","logs":[{"sender":"ai","content":"接吧，小胖子。","kind":"speech","timestamp":1788938096577,"ttsGroupTimestamp":1788938096577},{"sender":"user","content":"怎么还叫我小胖子？不和你玩了啊！（撅起嘴看镜头）","timestamp":1788938121656},{"sender":"ai","content":"他靠在办公椅上，眼角带了点笑意，抬手松了下领带","kind":"narration","timestamp":1788938166575,"ttsGroupTimestamp":1788938166575},{"sender":"ai","content":"又生气了？","kind":"speech","timestamp":1788938166576,"ttsGroupTimestamp":1788938166575},{"sender":"ai","content":"你自己刚才说的，涨了两公斤，这可不是我凭空捏造的。","kind":"speech","timestamp":1788938166577,"ttsGroupTimestamp":1788938166575},{"sender":"ai","content":"他伸手隔着屏幕虚捏了一下她噘着的嘴","kind":"narration","timestamp":1788938166578,"ttsGroupTimestamp":1788938166575},{"sender":"ai","content":"行了，别撅着了，挂油瓶呢？","kind":"speech","timestamp":1788938166579,"ttsGroupTimestamp":1788938166575},{"sender":"ai","content":"嘴唇干不干，先喝口水。","kind":"speech","timestamp":1788938166580,"ttsGroupTimestamp":1788938166575}],"isIncomingCall":true,"_id":3},{"userId":"uid_1785003826170_twrupamvi","characterId":"2a345620-7939-469a-9b2e-de9f8777f42f","id":"call_1788938286394_h3cme0","timestamp":1788938283575,"charId":"2a345620-7939-469a-9b2e-de9f8777f42f","duration":501,"status":"in_progress","logs":[{"sender":"ai","content":"网络连上了吗？","kind":"speech","timestamp":1788938286393,"ttsGroupTimestamp":1788938286393},{"sender":"ai","content":"让我看看是谁刚才哭唧唧说自己伤心了。","kind":"speech","timestamp":1788938286394,"ttsGroupTimestamp":1788938286393},{"sender":"user","content":"哼……哪有哭唧唧？（看着你，鼓起腮帮子）","timestamp":1788938311004},{"sender":"ai","content":"低笑了一声，靠在办公椅背上看着屏幕","kind":"narration","timestamp":1788938397442,"ttsGroupTimestamp":1788938397442},{"sender":"ai","content":"鼓得跟个小河豚似的，还说没有？","kind":"speech","timestamp":1788938397443,"ttsGroupTimestamp":1788938397442},{"sender":"ai","content":"刚才在微信里是谁跟我说伤心了？","kind":"speech","timestamp":1788938397444,"ttsGroupTimestamp":1788938397442},{"sender":"ai","content":"眼神往她那边扫了扫","kind":"narration","timestamp":1788938397445,"ttsGroupTimestamp":1788938397442},{"sender":"ai","content":"好了，腮帮子收一收。","kind":"speech","timestamp":1788938397446,"ttsGroupTimestamp":1788938397442},{"sender":"ai","content":"脚放好了没有？","kind":"speech","timestamp":1788938397447,"ttsGroupTimestamp":1788938397442},{"sender":"ai","content":"靠枕垫得高不高？","kind":"speech","timestamp":1788938397448,"ttsGroupTimestamp":1788938397442},{"sender":"user","content":"嗯，好好的呢（给你展示，在背景里面打了个哈欠）准备一会儿看会书","timestamp":1788938555218},{"sender":"ai","content":"眼神落在她打哈欠的小模样上，低低笑了声","kind":"narration","timestamp":1788938563985,"ttsGroupTimestamp":1788938563985},{"sender":"ai","content":"打着哈欠跟我说要看书？","kind":"speech","timestamp":1788938563986,"ttsGroupTimestamp":1788938563985},{"sender":"ai","content":"我看你这眼皮都快黏一块儿了。","kind":"speech","timestamp":1788938563987,"ttsGroupTimestamp":1788938563985},{"sender":"ai","content":"想看什么书？","kind":"speech","timestamp":1788938563988,"ttsGroupTimestamp":1788938563985},{"sender":"ai","content":"又是《面纱》？","kind":"speech","timestamp":1788938563989,"ttsGroupTimestamp":1788938563985},{"sender":"ai","content":"要是困了就眯一会儿，别强撑着。","kind":"speech","timestamp":1788938563990,"ttsGroupTimestamp":1788938563985},{"sender":"ai","content":"等会儿把眼睛看酸了，又得跟我嚷嚷。","kind":"speech","timestamp":1788938563991,"ttsGroupTimestamp":1788938563985},{"sender":"user","content":"嗯，面纱，昨天看了一半，今天把接下来的看完（我从旁边拿了眼镜出来）你什么时候回来呀？","timestamp":1788938776296},{"sender":"ai","content":"身子微微前倾，眼神温存地盯着屏幕","kind":"narration","timestamp":1788938787925,"ttsGroupTimestamp":1788938787925},{"sender":"ai","content":"把眼镜戴上了？","kind":"speech","timestamp":1788938787926,"ttsGroupTimestamp":1788938787925},{"sender":"ai","content":"想看就看会儿，不过把靠枕垫好，不准趴着看。","kind":"speech","timestamp":1788938787927,"ttsGroupTimestamp":1788938787925},{"sender":"ai","content":"我手头上还有两份批文要签，签完再跟顾洵交代一下，四点半左右能走。","kind":"speech","timestamp":1788938787928,"ttsGroupTimestamp":1788938787925},{"sender":"ai","content":"老赵车在下面备着呢，不出意外的话，五点前能回到月亮湾。","kind":"speech","timestamp":1788938787929,"ttsGroupTimestamp":1788938787925},{"sender":"ai","content":"声音放低了些，带着轻笑","kind":"narration","timestamp":1788938787930,"ttsGroupTimestamp":1788938787925},{"sender":"ai","content":"晚上想吃什么？","kind":"speech","timestamp":1788938787931,"ttsGroupTimestamp":1788938787925},{"sender":"ai","content":"我路上顺便给你带回去。","kind":"speech","timestamp":1788938787932,"ttsGroupTimestamp":1788938787925}],"isIncomingCall":true,"_id":4}]